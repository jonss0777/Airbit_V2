  <!-- BLUETOOTH UART RECEIVE HANDLER -->
  <block type="bluetooth_on_uart_data_received" id="btOnUartRx" x="900" y="0">
    <field name="delimiters">Delimiters.NewLine</field>
    <statement name="HANDLER">
      <block type="variables_set" id="setRawRx">
        <field name="VAR" id="rxMsgBuffer">rawData</field>
        <value name="VALUE">
          <block type="bluetooth_uart_read_until" id="readUntil">
            <field name="delimiters">Delimiters.NewLine</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="setBtRxTime">
            <field name="VAR" id="r7$BdSV@R2Zlqm)jXVuz">bluetoothReceivedTime</field>
            <value name="VALUE">
              <block type="device_get_running_time" id="getRunTime"></block>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- TELEMETRY TRANSMISSION FOREVER LOOP -->
  <block type="device_forever" id="btTelemetryLoop" x="1300" y="0">
    <statement name="HANDLER">
      <block type="bluetooth_uart_write_string" id="sendP">
        <value name="arg"><block type="text_join"><mutation items="2"></mutation><value name="ADD0"><block type="text"><field name="TEXT">p:</field></block></value><value name="ADD1"><block type="variables_get"><field name="VAR" id="~=HFt{s4-CE.}FG_|_vD">rollPitchP</field></block></value></block></value>
        <next>
          <block type="bluetooth_uart_write_string" id="sendVolt">
            <value name="arg"><block type="text_join"><mutation items="2"></mutation><value name="ADD0"><block type="text"><field name="TEXT">v:</field></block></value><value name="ADD1"><block type="variables_get"><field name="VAR" id="/q9N:vb1L7g8xA=BRfhn">batterymVoltSmooth</field></block></value></block></value>
            <next>
              <block type="device_pause" id="telemetryPause">
                <value name="pause"><shadow type="timePicker"><field name="ms">500</field></shadow></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- MAIN LOOP AND SENSOR CALCULATIONS -->
  <block type="device_forever" id="xQ=jZ2XUYp:zxLM,$hCp" x="1700" y="0">
    <statement name="HANDLER">
      <block type="function_call" id="_^B#5VsN%#T9q`~#DFjH">
        <mutation name="mainLoop" functionid="u.#pRYq#?Jc0cB%8mW$]"></mutation>
      </block>
    </statement>
  </block>

  <block type="device_forever" id="0pf$b[AC12~ul+cprz!y" x="2000" y="0">
    <statement name="HANDLER">
      <block type="airbit_batteryCalculation" id="#.t@$5+xRV,_.|cG5pEX"></block>
